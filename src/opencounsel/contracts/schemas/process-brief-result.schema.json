{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencounsel.local/schemas/process-brief-result.schema.json",
  "title": "OpenCounsel Process Brief Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "process_id",
    "status",
    "source_revision_id",
    "input_sha256",
    "corrected_sha256",
    "corrected_size_bytes",
    "correction_ledger_sha256",
    "correction_ledger_size_bytes",
    "correction_count",
    "lawyer_review_status",
    "created"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "process_id": {"type": "string", "pattern": "^proc-[0-9a-f]{64}$"},
    "status": {"const": "completed"},
    "source_revision_id": {"type": "string", "pattern": "^rev-[0-9a-f]{64}$"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_source_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_resolution_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "proofed_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "hyperlinked_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "corrected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corrected_size_bytes": {"type": "integer", "minimum": 0},
    "correction_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "correction_ledger_size_bytes": {"type": "integer", "minimum": 0},
    "front_matter_source_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "front_matter_source_size_bytes": {"type": "integer", "minimum": 0},
    "correction_count": {"type": "integer", "minimum": 0},
    "applied_correction_count": {"type": "integer", "minimum": 0},
    "review_item_count": {"type": "integer", "minimum": 0},
    "record_citation_count": {"type": "integer", "minimum": 0},
    "resolved_record_citation_count": {"type": "integer", "minimum": 0},
    "unresolved_record_citation_count": {"type": "integer", "minimum": 0},
    "authority_citation_count": {"type": "integer", "minimum": 0},
    "citation_review_item_count": {"type": "integer", "minimum": 0},
    "hyperlink_candidate_count": {"type": "integer", "minimum": 0},
    "hyperlink_inserted_count": {"type": "integer", "minimum": 0},
    "hyperlink_review_item_count": {"type": "integer", "minimum": 0},
    "toc_entry_count": {"type": "integer", "minimum": 0},
    "toa_authority_count": {"type": "integer", "minimum": 0},
    "toa_occurrence_count": {"type": "integer", "minimum": 0},
    "front_matter_field_candidate_count": {"type": "integer", "minimum": 0},
    "front_matter_field_applied_count": {"type": "integer", "minimum": 0},
    "front_matter_field_review_item_count": {"type": "integer", "minimum": 0},
    "toc_field_inserted_count": {"type": "integer", "minimum": 0},
    "toa_field_inserted_count": {"type": "integer", "minimum": 0},
    "lawyer_review_status": {"enum": ["not-required", "pending"]},
    "created": {"type": "boolean"}
  }
}
